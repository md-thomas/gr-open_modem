options:
  parameters:
    author: mdthomas
    catch_exceptions: 'True'
    category: '[open_modem]'
    cmake_opt: ''
    comment: Same TX/noisy-channel/RX/ACK loop as open_modem_noisy_loopback.grc, but
      open_modem_rx_0 also publishes the symbols it actually demodulated (post carrier/timing
      recovery, truncated to the real frame - see that block's own 'symbols_out' docstring)
      through a QT GUI Constellation Sink. Drag the noise slider up and watch the
      clusters smear from tight points into a blur as the mode's own cliff approaches
      - the same thing apps/margin_sweep.py and open_modem_noisy_loopback.grc show
      as numbers, here as a picture, live.
    copyright: ''
    description: open_modem RX constellation, live noisy-channel demo
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: open_modem_constellation
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: open_modem RX Constellation
    window_size: (1000, 800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: noise_sigma
  id: variable_qtgui_range
  parameters:
    comment: Same noise standard deviation as open_modem_noisy_loopback.grc's --noise-sigma,
      but a live slider here instead of a command-line value - drag it up while watching
      the constellation below.
    gui_hint: 0,0,1,1
    label: Noise sigma
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.02'
    stop: '2.0'
    value: '0.8'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 0.0]
    rotation: 0
    state: enabled
- name: ack_responder_0
  id: open_modem_ack_responder
  parameters:
    affinity: ''
    alias: ''
    comment: Turns open_modem_rx_0's ack_needed into a real ACK burst, fed back through
      the SAME noisy channel as open_modem_tx_0's own audio_out/ptt.
    dst_id: ALL
    fec_preset: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    mode_id: mode_id
    port: mic
    station_id: K0MDT
    tx_level: '0.7'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [872, 608.0]
    rotation: 0
    state: enabled
- name: analog_noise_source_x_0
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: noise_sigma
    comment: Gaussian noise added to the channel - standard deviation is the noise_sigma
      slider above.
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '42'
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [896, 152.0]
    rotation: 0
    state: enabled
- name: blocks_add_xx_0
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: The noisy channel itself - sums the clean audio burst stream with the
      Gaussian noise stream, continuously.
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1160, 168.0]
    rotation: 0
    state: enabled
- name: blocks_message_debug_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: Decoded frames (and bursts heard but not decoded, as noise increases)
      print here.
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 584.0]
    rotation: 180
    state: enabled
- name: blocks_message_debug_1
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: key/unkey events print here, from both open_modem_tx_0 and ack_responder_0.
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 200.0]
    rotation: 0
    state: enabled
- name: blocks_message_debug_2
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: Fires if ack_max_retries is exceeded with no ACK heard back.
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1448, 344.0]
    rotation: 0
    state: enabled
- name: blocks_message_strobe_0
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: Sends a fixed test message through the TX chain every 3 s.
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: pmt.intern("watch the constellation")
    period: '3000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [48, 248.0]
    rotation: 0
    state: enabled
- name: mode_id
  id: parameter
  parameters:
    alias: ''
    comment: The one Waveform Mode under test - open_modem_tx_0, open_modem_rx_0 and
      ack_responder_0 all reference this single value, not each its own copy (see
      open_modem_noisy_loopback.grc's own mode_id comment for why that matters - a
      mismatch fails outright, not just more often under noise).
    hide: none
    label: ''
    short_id: m
    type: intx
    value: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 8.0]
    rotation: 0
    state: enabled
- name: open_modem_rx_0
  id: open_modem_open_modem_rx
  parameters:
    affinity: ''
    alias: ''
    comment: mode_ids is a single-element list referencing the shared mode_id parameter
      above, so it can never drift out of sync with open_modem_tx_0.
    fec_preset: ''
    max_burst_s: '6.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    mode_ids: '[mode_id]'
    port: mic
    sample_rate: '48000'
    threshold: '0.4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 408.0]
    rotation: 180
    state: enabled
- name: open_modem_tx_0
  id: open_modem_open_modem_tx
  parameters:
    ack_max_retries: '3'
    ack_requested: 'True'
    ack_timeout_s: '2.0'
    affinity: ''
    alias: ''
    comment: ''
    dst_id: ALL
    fec_preset: ''
    lead_in_s: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    mode_id: mode_id
    port: mic
    station_id: K0MDT
    tail_s: '0.02'
    tx_level: '0.7'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 276.0]
    rotation: 0
    state: enabled
- name: pdu_to_stream_0
  id: open_modem_pdu_to_stream
  parameters:
    affinity: ''
    alias: ''
    comment: Drains open_modem_tx_0's (and ack_responder_0's) audio_out PDUs into
      a float stream a work() call at a time - see open_modem_loopback.grc's own top-level
      comment for why not the stock PDU to Tagged Stream block (that limitation is
      specific to the much larger audio-sample-rate stream, not the much smaller symbol-rate
      one below, which uses that stock block fine).
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [688, 40.0]
    rotation: 0
    state: enabled
- name: pdu_to_tagged_stream_0
  id: open_modem_pdu_to_stream
  parameters:
    affinity: ''
    alias: ''
    comment: Converts open_modem_rx_0's symbols_out PDU (demodulated complex symbols,
      truncated to the real frame) into a complex stream for the Constellation Sink.
      NOT the stock PDU to Tagged Stream block - confirmed live that it hits this
      system's buffer ceiling (same bug as pdu_to_stream's own docstring describes
      for the audio-sample-rate case) once enough bursts queue up, and its thread
      dies permanently when it does, which looked like "the plot stopped updating
      and the noise slider doesn't fix it" - because it doesn't; the block feeding
      it is dead. This block drains incrementally instead, so it can't hit that
      ceiling at all.
    dtype: complex
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1432, 528.0]
    rotation: 0
    state: enabled
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: Required here, not optional - pdu_to_tagged_stream_0 has no real
      source/sink pacing it (nothing like real-time audio hardware governs this
      symbol-rate stream), so with nothing downstream to rate-limit it, it free-runs
      as fast as the CPU allows between bursts, filling with idle zeros - confirmed
      live, 168 MILLION samples in 5 seconds, unthrottled. blocks.throttle's own
      docstring says exactly this - "should only be used in GUI apps where there is
      no other rate limiting block" - precisely this flowgraph.
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: '9600'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1432, 624.0]
    rotation: 0
    state: enabled
- name: qtgui_const_sink_x_0
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: Each point is one demodulated symbol. Tight clusters at the mode's ideal
      constellation points means a clean decode; a smeared ring or blob means noise_sigma
      is past (or near) this mode's cliff.
    grid: 'True'
    gui_hint: 1,0,1,1
    label1: ''
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    marker1: '0'
    marker10: '0'
    marker2: '0'
    marker3: '0'
    marker4: '0'
    marker5: '0'
    marker6: '0'
    marker7: '0'
    marker8: '0'
    marker9: '0'
    name: '""'
    nconnections: '1'
    size: '1024'
    style1: '0'
    style10: '0'
    style2: '0'
    style3: '0'
    style4: '0'
    style5: '0'
    style6: '0'
    style7: '0'
    style8: '0'
    style9: '0'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1616, 632.0]
    rotation: 0
    state: enabled

connections:
- [ack_responder_0, audio_out, pdu_to_stream_0, pdus]
- [ack_responder_0, ptt, blocks_message_debug_1, print]
- [analog_noise_source_x_0, '0', blocks_add_xx_0, '1']
- [blocks_add_xx_0, '0', open_modem_rx_0, '0']
- [blocks_message_strobe_0, strobe, open_modem_tx_0, pdu_in]
- [open_modem_rx_0, ack_needed, ack_responder_0, ack_needed]
- [open_modem_rx_0, ack_received, open_modem_tx_0, ack_received]
- [open_modem_rx_0, pdu_out, blocks_message_debug_0, print]
- [open_modem_rx_0, symbols_out, pdu_to_tagged_stream_0, pdus]
- [open_modem_tx_0, audio_out, pdu_to_stream_0, pdus]
- [open_modem_tx_0, delivery_failed, blocks_message_debug_2, print]
- [open_modem_tx_0, ptt, blocks_message_debug_1, print]
- [pdu_to_stream_0, '0', blocks_add_xx_0, '0']
- [blocks_throttle2_0, '0', qtgui_const_sink_x_0, '0']
- [pdu_to_tagged_stream_0, '0', blocks_throttle2_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
