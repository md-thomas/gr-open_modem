options:
  parameters:
    author: mdthomas
    catch_exceptions: 'True'
    category: '[open_modem]'
    cmake_opt: ''
    comment: Same TX/noisy-channel/RX/ACK loop as open_modem_noisy_loopback.grc,
      but open_modem_rx_0 also publishes the symbols it actually demodulated
      (post carrier/timing recovery, truncated to the real frame - see that
      block's own 'symbols_out' docstring) through a QT GUI Constellation
      Sink. Drag the noise slider up and watch the clusters smear from tight
      points into a blur as the mode's own cliff approaches - the same thing
      apps/margin_sweep.py and open_modem_noisy_loopback.grc show as numbers,
      here as a picture, live.
    copyright: ''
    description: open_modem RX constellation, live noisy-channel demo
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: open_modem_constellation
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: open_modem RX Constellation
    window_size: (1000, 800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: mode_id
  id: parameter
  parameters:
    alias: ''
    comment: The one Waveform Mode under test - open_modem_tx_0, open_modem_rx_0
      and ack_responder_0 all reference this single value, not each its own copy
      (see open_modem_noisy_loopback.grc's own mode_id comment for why that
      matters - a mismatch fails outright, not just more often under noise).
    hide: none
    label: ''
    short_id: m
    type: intx
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 8.0]
    rotation: 0
    state: enabled
- name: noise_sigma
  id: variable_qtgui_range
  parameters:
    comment: Same noise standard deviation as open_modem_noisy_loopback.grc's
      --noise-sigma, but a live slider here instead of a command-line value -
      drag it up while watching the constellation below.
    gui_hint: 0,0,1,1
    label: Noise sigma
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.02'
    stop: '2.0'
    value: '0.3'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 72.0]
    rotation: 0
    state: enabled
- name: blocks_message_strobe_0
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: Sends a fixed test message through the TX chain every 3 s.
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: pmt.intern("watch the constellation")
    period: '3000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [48, 180]
    rotation: 0
    state: enabled
- name: open_modem_tx_0
  id: open_modem_open_modem_tx
  parameters:
    ack_max_retries: '3'
    ack_requested: 'True'
    ack_timeout_s: '2.0'
    affinity: ''
    alias: ''
    comment: ''
    dst_id: ALL
    fec_preset: ''
    lead_in_s: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    mode_id: mode_id
    port: mic
    station_id: K0MDT
    tail_s: '0.02'
    tx_level: '0.7'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 276.0]
    rotation: 0
    state: enabled
- name: pdu_to_stream_0
  id: open_modem_pdu_to_stream
  parameters:
    affinity: ''
    alias: ''
    comment: Drains open_modem_tx_0's (and ack_responder_0's) audio_out PDUs into
      a float stream a work() call at a time - see open_modem_loopback.grc's own
      top-level comment for why not the stock PDU to Tagged Stream block (that
      limitation is specific to the much larger audio-sample-rate stream, not
      the much smaller symbol-rate one below, which uses that stock block fine).
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [688, 40.0]
    rotation: 0
    state: enabled
- name: analog_noise_source_x_0
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: noise_sigma
    comment: Gaussian noise added to the channel - standard deviation is the
      noise_sigma slider above.
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '42'
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [872, 184.0]
    rotation: 0
    state: enabled
- name: blocks_add_xx_0
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: The noisy channel itself - sums the clean audio burst stream with
      the Gaussian noise stream, continuously.
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1160, 168.0]
    rotation: 0
    state: enabled
- name: open_modem_rx_0
  id: open_modem_open_modem_rx
  parameters:
    affinity: ''
    alias: ''
    comment: mode_ids is a single-element list referencing the shared mode_id
      parameter above, so it can never drift out of sync with open_modem_tx_0.
    fec_preset: ''
    max_burst_s: '6.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    mode_ids: '[mode_id]'
    port: mic
    sample_rate: '48000'
    threshold: '0.4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [712, 424.0]
    rotation: 180
    state: enabled
- name: ack_responder_0
  id: open_modem_ack_responder
  parameters:
    affinity: ''
    alias: ''
    comment: Turns open_modem_rx_0's ack_needed into a real ACK burst, fed back
      through the SAME noisy channel as open_modem_tx_0's own audio_out/ptt.
    dst_id: ALL
    fec_preset: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    mode_id: mode_id
    port: mic
    station_id: K0MDT
    tx_level: '0.7'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [960, 608.0]
    rotation: 0
    state: enabled
- name: blocks_message_debug_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: Decoded frames (and bursts heard but not decoded, as noise increases)
      print here.
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 592.0]
    rotation: 180
    state: enabled
- name: blocks_message_debug_1
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: key/unkey events print here, from both open_modem_tx_0 and
      ack_responder_0.
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1456, 464.0]
    rotation: 0
    state: enabled
- name: blocks_message_debug_2
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: Fires if ack_max_retries is exceeded with no ACK heard back.
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1336, 288.0]
    rotation: 0
    state: enabled
- name: pdu_to_tagged_stream_0
  id: pdu_pdu_to_tagged_stream
  parameters:
    affinity: ''
    alias: ''
    comment: Converts open_modem_rx_0's symbols_out PDU (demodulated complex
      symbols, truncated to the real frame) into a tagged complex stream for the
      Constellation Sink. The stock block's buffer limits (see TODO.md) only bite
      for audio-sample-rate PDUs - symbol counts per burst are hundreds to low
      thousands, well under that ceiling.
    maxoutbuf: '0'
    minoutbuf: '0'
    tag: packet_len
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 760.0]
    rotation: 0
    state: enabled
- name: qtgui_const_sink_x_0
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: '"blue"'
    comment: Each point is one demodulated symbol. Tight clusters at the mode's
      ideal constellation points means a clean decode; a smeared ring or blob
      means noise_sigma is past (or near) this mode's cliff.
    grid: 'True'
    gui_hint: 1,0,1,1
    label1: ''
    legend: 'True'
    marker1: '0'
    name: '""'
    nconnections: '1'
    size: '1024'
    style1: '0'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1296, 760.0]
    rotation: 0
    state: enabled

connections:
- [ack_responder_0, audio_out, pdu_to_stream_0, pdus]
- [ack_responder_0, ptt, blocks_message_debug_1, print]
- [analog_noise_source_x_0, '0', blocks_add_xx_0, '1']
- [blocks_add_xx_0, '0', open_modem_rx_0, '0']
- [blocks_message_strobe_0, strobe, open_modem_tx_0, pdu_in]
- [open_modem_rx_0, ack_needed, ack_responder_0, ack_needed]
- [open_modem_rx_0, ack_received, open_modem_tx_0, ack_received]
- [open_modem_rx_0, pdu_out, blocks_message_debug_0, print]
- [open_modem_rx_0, symbols_out, pdu_to_tagged_stream_0, pdus]
- [open_modem_tx_0, audio_out, pdu_to_stream_0, pdus]
- [open_modem_tx_0, delivery_failed, blocks_message_debug_2, print]
- [open_modem_tx_0, ptt, blocks_message_debug_1, print]
- [pdu_to_stream_0, '0', blocks_add_xx_0, '0']
- [pdu_to_tagged_stream_0, '0', qtgui_const_sink_x_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
